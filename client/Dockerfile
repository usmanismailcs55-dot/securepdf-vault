FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

ARG VITE_PAYMENT_RECEIVING_WALLET
ARG VITE_PAYMENT_AMOUNT
ARG VITE_PAYMENT_ASSET
ARG VITE_PAYMENT_NETWORK
ARG VITE_TRON_API_URL

ENV VITE_PAYMENT_RECEIVING_WALLET=$VITE_PAYMENT_RECEIVING_WALLET
ENV VITE_PAYMENT_AMOUNT=$VITE_PAYMENT_AMOUNT
ENV VITE_PAYMENT_ASSET=$VITE_PAYMENT_ASSET
ENV VITE_PAYMENT_NETWORK=$VITE_PAYMENT_NETWORK
ENV VITE_TRON_API_URL=$VITE_TRON_API_URL

RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
