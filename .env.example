# ==========================================
# Server
# ==========================================
PORT=5000
NODE_ENV=production

# ==========================================
# MongoDB
# ==========================================
MONGODB_URI=your_production_mongodb_uri_here

# ==========================================
# Authentication
# ==========================================
JWT_SECRET=your_production_jwt_secret_here

# ==========================================
# Frontend
# ==========================================
CLIENT_URL=https://your-production-domain.example

# ==========================================
# Email
# ==========================================
EMAIL_USER=your_production_email@example.com
EMAIL_PASSWORD=your_production_email_password_here

# ==========================================
# Trust Wallet / Crypto
# ==========================================
PAYMENT_NETWORK=TRON
PAYMENT_ASSET=USDT
PAYMENT_RECEIVING_WALLET=your_receiving_wallet_address_here
TRON_API_URL=https://api.trongrid.io

# ==========================================
# File Encryption
# ==========================================
FILE_ENCRYPTION_KEY=your_64_character_hex_aes256_key_here

# ==========================================
# Backblaze B2
# ==========================================
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=your_production_bucket_name_here
B2_KEY_ID=your_b2_key_id_here
B2_APPLICATION_KEY=your_b2_application_key_here